CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
CELESTO_BACKEND=firecracker
CELESTO_TEMPLATE=coding-agent
CELESTO_LOCAL_IMAGE=replace-with-absolute-path-to-python3-alpine-rootfs
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name
LLM_FREE_ONLY=true
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080
MAX_CONCURRENT_JOBS=1
COMMAND_TIMEOUT_S=60
MAX_MODEL_TURNS=5
SANDBOX_HOURLY_USD=0.015
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
API_ACCESS_TOKEN=replace-with-a-long-random-local-token
